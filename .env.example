# === Salez.online Frontend Environment Variables ===

# Backend API base URL
# Dev:  http://localhost:4000  (backend default port is 4000, NOT 5000)
# Prod: set to your production backend domain (WITHOUT /api/v1 suffix)
# ⚠️ FIX (Issue 8): Port was 5000, backend runs on 4000.
VITE_API_URL=https://salez-backend.onrender.com

# Local development override:
# VITE_API_URL=http://localhost:4000

# Environment flag
VITE_NODE_ENV=development
